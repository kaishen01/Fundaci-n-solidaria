<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= title %>
    </title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('partials/nav') %>

        <section class="hero">

            <div class="overlay"></div>

            <div class="hero-content">
                <h1>Fundación Solidaria</h1>
                <h2>"UNA NUEVA HISTORIA"</h2>

                <p>
                    Transformando vidas mediante la solidaridad,
                    la educación y el compromiso social.
                </p>

                <a href="/nosotros" class="btn">
                    Conoce Más
                </a>
            </div>

        </section>

        <section class="about">

            <div class="container">

                <h2>¿Quiénes Somos?</h2>

                <p>
                    La Fundación "Una Nueva Historia" es una institución sin fines de lucro
                    dedicada a transformar la realidad de personas en situación de vulnerabilidad
                    social mediante acciones solidarias, educativas y de apoyo comunitario.
                </p>

                <p>
                    Nuestro objetivo es devolver esperanza, dignidad y oportunidades,
                    promoviendo la inclusión y el desarrollo integral de quienes más lo necesitan.
                </p>

            </div>

        </section>

        <section class="values">

            <div class="container">

                <h2>Nuestros Valores</h2>

                <div class="cards">

                    <div class="card">
                        <h3>❤️ Solidaridad</h3>
                        <p>Ayudamos a quienes más lo necesitan.</p>
                    </div>

                    <div class="card">
                        <h3>🤝 Compromiso</h3>
                        <p>Trabajamos con responsabilidad y transparencia.</p>
                    </div>

                    <div class="card">
                        <h3>🌱 Esperanza</h3>
                        <p>Construimos oportunidades para un mejor futuro.</p>
                    </div>

                </div>

            </div>

        </section>

        <section class="future-projects">

            <div class="container">

                <h2>Ejes de Acción</h2>

                <p class="section-description">
                    Nuestras iniciativas están orientadas a brindar apoyo, esperanza y oportunidades
                    a personas que enfrentan situaciones de vulnerabilidad social.
                </p>

                <div class="projects-grid">

                    <div class="project-card">

                        <img src="/img/ejes/eje1.jpeg" alt="Alivio y esperanza">

                        <div class="project-content">

                            <h3>💙 Alivio y esperanza</h3>

                            <p>
                                Proyectos de apoyo humanitario, provisión de insumos médicos y
                                acompañamiento a personas que enfrentan el cáncer.
                            </p>

                        </div>

                    </div>

                    <div class="project-card">

                        <img src="/img/ejes/eje2.jpeg" alt="Dignidad en la vejez">

                        <div class="project-content">

                            <h3>👴 Dignidad en la vejez</h3>

                            <p>
                                Rescatar del olvido a los adultos mayores en situación de abandono,
                                fortaleciendo redes de asistencia, cuidado y afecto.
                            </p>

                        </div>

                    </div>

                    <div class="project-card">

                        <img src="/img/ejes/eje3.jpeg" alt="Puentes hacia el hogar">

                        <div class="project-content">

                            <h3>🏠 Puentes hacia el hogar</h3>

                            <p>
                                Desarrollar estrategias de atención, acompañamiento y reintegración
                                social para personas en situación de calle.
                            </p>

                        </div>

                    </div>

                    <div class="project-card">

                        <img src="/img/ejes/eje4.jpeg" alt="Restauración de vidas">

                        <div class="project-content">

                            <h3>🔄 Restauración de vidas</h3>

                            <p>
                                Proyectos de orientación, rehabilitación y reinserción para personas
                                que enfrentan adicciones, promoviendo una nueva oportunidad de vida.
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </section>

        <%- include('partials/footer') %>

            <script src="/js/app.js"></script>

</body>

</html>